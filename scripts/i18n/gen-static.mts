// Generate a static UI dictionary for one language with Meta Muse Spark (same placeholder protection as runtime).
// Run: AW_NO_PERSIST=1 node --env-file=.env.local --import tsx scripts/i18n/gen-static.mts ko   → writes lib/i18n/ko.ts for review.
import { writeFileSync } from "node:fs";
import { en } from "../../lib/i18n/dictionary";
import { translateMany } from "../../lib/i18n/translate";
const lang = process.argv[2] ?? "ko";
delete process.env.GOOGLE_TRANSLATE_API_KEY;
const keys = Object.keys(en) as (keyof typeof en)[];
const vals = await translateMany(keys.map((k) => en[k]), lang, ["SaveBell", "Meta Muse Spark", "Meta Muse Code", "GitHub", "Claude Code", "Codex", "MCP", "Slack", "Discord"]);
const missing = keys.filter((k, i) => vals[i] === en[k]);
const body = keys.map((k, i) => `  ${k}: ${JSON.stringify(vals[i])},`).join("\n");
writeFileSync(`lib/i18n/${lang}.ts`, `// ${lang} UI dictionary, generated by Meta Muse Spark (scripts/i18n/gen-static.mts) and reviewed. Keys missing here fall back to English.\nimport type { Dict } from "./dictionary";\nexport const dict: Partial<Dict> = {\n${body}\n};\n`);
console.log(`${keys.length} keys, ${missing.length} unchanged: ${missing.join(", ")}`);
