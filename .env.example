# SaveBell environment variables. Copy to .env.local for development. Never commit real values.
# Required for analysis (Meta Model API, https://dev.meta.ai)
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Storage and scheduler (Upstash). Without Redis the app uses an in-memory/JSON store; without QStash jobs run inline.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# GitHub App (sign-in uses the App's OAuth client; repository reads use installation tokens)
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=            # optional read-only fallback for repositories without an installation

# Automated remediation (Muse Code runner on GitHub Actions). Off unless FIX_ENABLED=1.
FIX_ENABLED=0
RUNNER_DISPATCH_TOKEN=   # fine-grained PAT, Actions: write on this repository only
ARGUS_RUNNER_SECRET=     # shared with the Actions secret of the same name
RUNNER_REPO=chewonc/save-bell

# Optional
ADMIN_TOKEN=             # protects /api/admin, replay and manual routes
APP_URL=                 # public URL; defaults to the Vercel production URL
ALERT_WEBHOOK_URL=       # global Slack/Discord webhook
GOOGLE_TRANSLATE_API_KEY=  # optional; without it Muse Spark translates
NVD_API_KEY=             # optional; raises the NVD rate limit
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
HOSTED_ANALYSIS_CAP=20
DEMO_SHARED_REPOS=0
WONDER_ESCALATION=0

# Local development only (never set in production): sign in as a stub user without GitHub OAuth
AW_DEV_USER=
